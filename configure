#!/bin/sh

echo "Configuring GSVA..."

# ---- nvcc ----
if [ -n "$NVCC" ]; then
    : # user-supplied
else
    NVCC="$(command -v nvcc)"
fi

if [ -n "$CUDA_HOME" ]; then
    NVCC="$CUDA_HOME/bin/nvcc"
elif [ -n "$CUDA_PATH" ]; then
    NVCC="$CUDA_PATH/bin/nvcc"
fi

if [ -n "$NVCC" ]; then
    if ! "$NVCC" --version >/dev/null 2>&1; then
        echo "nvcc found at $NVCC but not executable: building CPU only" >&2
        NVCC=""
    fi
fi

# ---- CUDA version ----
if [ -n "$NVCC" ]; then
    CUDA_VERSION=$("$NVCC" --version 2>/dev/null \
        | sed -n 's/^.*release \([^ ,]*\),.*/\1/p' || true)
    if [ -n "$CUDA_VERSION" ]; then
        echo "nvcc version is $CUDA_VERSION"
    fi
fi

# ---- GPU compute capability ----
if [ -n "$NVCC" ]; then
    if [ -n "$GPU_ARCH" ]; then
        GPU_ARCH_FLAGS="--generate-code arch=compute_${GPU_ARCH},code=[compute_${GPU_ARCH},sm_${GPU_ARCH}]"
        echo "GPU arch: sm_${GPU_ARCH} (user override)"
    else
        if command -v nvidia-smi >/dev/null 2>&1; then
            GPU_COMPUTE_CAPABILITY=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null \
                | sed 's/\.//g' | sort -n | head -n 1 | tr -d ' ')
            if [ -z "$GPU_COMPUTE_CAPABILITY" ]; then
                echo "*** nvidia-smi available but returned no GPUs. Falling back to CPU-only build." >&2
                echo "*** Set GPU_ARCH to build for a specific architecture anyway." >&2
                NVCC=""
                GPU_ARCH_FLAGS=""
            else
                GPU_ARCH_FLAGS="--generate-code arch=compute_${GPU_COMPUTE_CAPABILITY},code=[compute_${GPU_COMPUTE_CAPABILITY},sm_${GPU_COMPUTE_CAPABILITY}]"
                echo "GPU arch: sm_${GPU_COMPUTE_CAPABILITY} (auto)"
            fi
        else
            echo "*** nvidia-smi not found. Falling back to CPU-only build." >&2
            NVCC=""
            GPU_ARCH_FLAGS=""
        fi
    fi
else
    GPU_ARCH_FLAGS=""
fi

# ---- CUDA runtime library directory ----
CUDA_HOME_RESOLVED=""
CUDA_LIBDIR=""
if [ -n "$NVCC" ]; then
    if [ -n "$CUDA_HOME" ]; then
        CUDA_HOME_RESOLVED="$CUDA_HOME"
    elif [ -n "$CUDA_PATH" ]; then
        CUDA_HOME_RESOLVED="$CUDA_PATH"
    else
        case "$NVCC" in
            */bin/nvcc) CUDA_HOME_RESOLVED="${NVCC%/bin/nvcc}" ;;
        esac
    fi
    if [ -n "$CUDA_HOME_RESOLVED" ]; then
        for cuda_lib in "$CUDA_HOME_RESOLVED/lib64" "$CUDA_HOME_RESOLVED/lib"; do
            if [ -d "$cuda_lib" ]; then
                CUDA_LIBDIR="$cuda_lib"
                break
            fi
        done
    fi
fi

# ---- R's C++ toolchain: nvcc host compiler and GSVA.so link driver ----
R_CXX=""
NVCC_CCBIN=""
if [ -n "$NVCC" ]; then
    R_CXX=$(R CMD config CXX 2>/dev/null)
    if [ -z "$R_CXX" ]; then
        echo "*** R CMD config CXX failed: building CPU only" >&2
        NVCC=""
    else
        NVCC_CCBIN=$(printf '%s\n' "$R_CXX" | cut -d' ' -f1)
    fi
fi

# ---- CUDA toolchain probe ----
# Compile and link a small .cu with the very recipe src/Makevars uses,
# and fall back to a CPU-only build when that does not work.
if [ -n "$NVCC" ]; then
    R_CXXPICFLAGS=$(R CMD config CXXPICFLAGS 2>/dev/null)
    R_CXXFLAGS=$(R CMD config CXXFLAGS 2>/dev/null)
    # keep LTO out of nvcc's host flags
    R_CXXFLAGS_SAFE=$(printf '%s\n' $R_CXXFLAGS | grep -v 'lto' | tr '\n' ' ')
    R_CPPFLAGS=$(R CMD config --cppflags 2>/dev/null)
    R_LDFLAGS=$(R CMD config LDFLAGS 2>/dev/null)

    PROBE_DIR=$(mktemp -d 2>/dev/null)
    if [ -z "$PROBE_DIR" ]; then
        echo "*** could not create a probe directory: building CPU only" >&2
        NVCC=""
    else
        cat > "$PROBE_DIR/probe.cu" <<'PROBE_CU'
#include <cuda_runtime.h>
__global__ void gsva_probe_kernel(double *x) { if (x) x[0] *= 2.0; }
extern "C" int gsva_probe(void) {
    double *d = 0;
    if (cudaMalloc(&d, sizeof(double)) == cudaSuccess) cudaFree(d);
    return 0;
}
PROBE_CU
        PROBE_LOG="$PROBE_DIR/probe.log"
        if ! "$NVCC" -std=c++17 -O3 $GPU_ARCH_FLAGS -ccbin "$NVCC_CCBIN" \
                -c "$PROBE_DIR/probe.cu" -o "$PROBE_DIR/probe.o" \
                $R_CPPFLAGS -DNDEBUG -DHAVE_CUDA -DUSE_FP32 \
                -Xcompiler "$R_CXXPICFLAGS $R_CXXFLAGS_SAFE" \
                >"$PROBE_LOG" 2>&1; then
            echo "*** CUDA test compile failed: building CPU only" >&2
            sed -n '1,6p' "$PROBE_LOG" | sed 's/^/> /' >&2
            echo "*** Check the CUDA toolkit or override detection with" >&2
            echo "*** NVCC/CUDA_HOME/GPU_ARCH and reinstall." >&2
            NVCC=""
        elif ! $R_CXX -shared $R_LDFLAGS -o "$PROBE_DIR/probe.so" \
                "$PROBE_DIR/probe.o" \
                ${CUDA_LIBDIR:+-L"$CUDA_LIBDIR"} -lcudart \
                >"$PROBE_LOG" 2>&1; then
            echo "*** CUDA test link failed: building CPU only" >&2
            sed -n '1,6p' "$PROBE_LOG" | sed 's/^/> /' >&2
            echo "*** The CUDA runtime (libcudart) was not usable from" >&2
            echo "*** ${CUDA_LIBDIR:-a CUDA library directory}; set CUDA_HOME" >&2
            echo "*** to the toolkit prefix and reinstall." >&2
            NVCC=""
        else
            echo "CUDA toolchain probe passed (host compiler: $NVCC_CCBIN, CUDA libs: ${CUDA_LIBDIR:-default search path})"
        fi
        rm -rf "$PROBE_DIR"
    fi
fi

# ---- source files ----
if ! cd "$(dirname "$0")/src"; then
    echo "*** Failed to enter src directory" >&2
    exit 1
fi

CU_OBJS=""
if [ -n "$NVCC" ]; then
    for f in cuda/*.cu; do
        [ -f "$f" ] && CU_OBJS="$CU_OBJS ${f%.cu}.o"
    done
fi

# ---- link setup ----
if [ -n "$NVCC" ]; then
    HAVE_CUDA_DEF="-DHAVE_CUDA"
    SHLIB_LD_TOOL='$(CXX)'
    CUDA_LINK="-L${CUDA_LIBDIR} -lcudart"
else
    HAVE_CUDA_DEF=""
    SHLIB_LD_TOOL='$(CC)'
    CUDA_LINK=""
fi

# ---- generate src/Makevars from src/Makevars.in ----
sed -e "s|@NVCC@|${NVCC}|g" \
    -e "s|@NVCC_CCBIN@|${NVCC_CCBIN}|g" \
    -e "s|@GPU_ARCH_FLAGS@|${GPU_ARCH_FLAGS}|g" \
    -e "s|@CUDA_LIBDIR@|${CUDA_LIBDIR}|g" \
    -e "s|@CUDA_LINK@|${CUDA_LINK}|g" \
    -e "s|@SHLIB_LD@|${SHLIB_LD_TOOL}|g" \
    -e "s|@HAVE_CUDA_DEF@|${HAVE_CUDA_DEF}|g" \
    -e "s|@CU_OBJS@|${CU_OBJS}|g" \
    Makevars.in > Makevars
if [ $? -ne 0 ] || [ ! -s Makevars ]; then
    echo "*** Failed to generate src/Makevars from src/Makevars.in" >&2
    exit 1
fi

if [ -n "$NVCC" ]; then
    echo "CUDA build enabled."
else
    echo "CPU-only build."
fi
echo "src/Makevars written."
