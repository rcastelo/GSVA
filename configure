#!/bin/sh

echo "Configuring GSVA..."

# ---- nvcc ----
if [ -n "$NVCC" ]; then
    : # user-supplied
else
    NVCC="$(command -v nvcc)"
fi

if [ -n "$CUDA_HOME" ]; then
    NVCC="$CUDA_HOME/bin/nvcc"
elif [ -n "$CUDA_PATH" ]; then
    NVCC="$CUDA_PATH/bin/nvcc"
fi

if [ -n "$NVCC" ]; then
    if ! "$NVCC" --version >/dev/null 2>&1; then
        echo "nvcc found at $NVCC but not executable: building CPU only" >&2
        NVCC=""
    fi
fi

# ---- CUDA version ----
if [ -n "$NVCC" ]; then
    CUDA_VERSION=$("$NVCC" --version 2>/dev/null \
        | sed -n 's/^.*release \([^ ,]*\),.*/\1/p' || true)
    if [ -n "$CUDA_VERSION" ]; then
        echo "nvcc version is $CUDA_VERSION"
    fi
fi

# ---- GPU compute capability ----
if [ -n "$NVCC" ]; then
    if [ -n "$GPU_ARCH" ]; then
        GPU_ARCH_FLAGS="--generate-code arch=compute_${GPU_ARCH},code=[compute_${GPU_ARCH},sm_${GPU_ARCH}]"
        echo "GPU arch: sm_${GPU_ARCH} (user override)"
    else
        if command -v nvidia-smi >/dev/null 2>&1; then
            GPU_COMPUTE_CAPABILITY=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null \
                | sed 's/\.//g' | sort -n | head -n 1 | tr -d ' ')
            if [ -z "$GPU_COMPUTE_CAPABILITY" ]; then
                echo "*** nvidia-smi available but returned no GPUs. Falling back to CPU-only build." >&2
                echo "*** Set GPU_ARCH to build for a specific architecture anyway." >&2
                NVCC=""
                GPU_ARCH_FLAGS=""
            else
                GPU_ARCH_FLAGS="--generate-code arch=compute_${GPU_COMPUTE_CAPABILITY},code=[compute_${GPU_COMPUTE_CAPABILITY},sm_${GPU_COMPUTE_CAPABILITY}]"
                echo "GPU arch: sm_${GPU_COMPUTE_CAPABILITY} (auto)"
            fi
        else
            echo "*** nvidia-smi not found. Falling back to CPU-only build." >&2
            NVCC=""
            GPU_ARCH_FLAGS=""
        fi
    fi
else
    GPU_ARCH_FLAGS=""
fi

# ---- source files ----
if ! cd "$(dirname "$0")/src"; then
    echo "*** Failed to enter src directory" >&2
    exit 1
fi

C_OBJS=""
for f in *.c; do
    [ -f "$f" ] && C_OBJS="$C_OBJS $(basename "$f" .c).o"
done

CU_OBJS=""
if [ -n "$NVCC" ]; then
    for f in cuda/*.cu; do
        [ -f "$f" ] && CU_OBJS="$CU_OBJS ${f%.cu}.o"
    done
fi

# ---- preprocessor defines ----
if [ -n "$NVCC" ]; then
    HAVE_CUDA_DEF="-DHAVE_CUDA"
else
    HAVE_CUDA_DEF=""
fi

# ---- write src/Makeconf ----
cat > Makeconf <<MC
# Auto-generated by configure. Do not edit.
# C object files
C_OBJS = ${C_OBJS}
# CUDA object files (empty if no CUDA)
CU_OBJS = ${CU_OBJS}
# CUDA compiler (empty if no CUDA)  
NVCC = ${NVCC}
# GPU architecture flags (empty if no CUDA)
GPU_ARCH_FLAGS = ${GPU_ARCH_FLAGS}
# nvcc flags
NVCC_FLAGS = -O3
# FP32 define
FP32_FLAG = -DUSE_FP32
# HAVE_CUDA preprocessor define (empty if no CUDA)
HAVE_CUDA_DEF = ${HAVE_CUDA_DEF}
# Common flags
PKG_CPPFLAGS += \$(HAVE_CUDA_DEF) \$(FP32_FLAG)
MC
if [ $? -ne 0 ]; then
    echo "*** Failed to write src/Makeconf" >&2
    exit 1
fi

# Override SHLIB_LD with nvcc for CUDA builds
if [ -n "$NVCC" ]; then
    echo "SHLIB_LD = ${NVCC}" >> Makeconf
fi

echo "src/Makeconf written."
