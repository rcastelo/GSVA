> gs <- as.list(sample(10:100, size=100, replace=TRUE))
> gs <- lapply(gs, function(n, p)
+                    paste0("g", sample(1:p, size=n, replace=FALSE)), p)
> names(gs) <- paste0("gs", 1:length(gs))
> ssgseaPar <- ssgseaParam(X, gs)
