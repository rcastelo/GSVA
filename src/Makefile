-include Makevars

SHLIB = GSVA.so
OBJECTS = $(CU_OBJS) $(C_OBJS)

all: $(SHLIB)

$(SHLIB): $(OBJECTS) | ensure-makevars
	$(SHLIB_LINK) -o $@ $(OBJECTS) $(ALL_LIBS)

# Fail loudly instead of linking an object-less GSVA.so when the configure
# generated Makevars is missing (e.g. 'R CMD INSTALL --no-configure').
ensure-makevars:
	@if test -z "$(C_OBJS)"; then \
	  echo "*** src/Makevars is missing or empty." >&2; \
	  echo "*** It is generated by the package's configure script." >&2; \
	  echo "*** Reinstall with 'R CMD INSTALL' (without --no-configure), or run" >&2; \
	  echo "*** 'sh ../configure' from this directory before calling make." >&2; \
	  exit 1; \
	fi

cuda/%.o: cuda/%.cu
	$(NVCC) -std=c++17 $(FP32_FLAG) $(GPU_ARCH_FLAGS) $(NVCC_FLAGS) -MMD -MP -c $< -o $@ $(HAVE_CUDA_DEF) $(ALL_CPPFLAGS) -I. -Xcompiler "$(CPICFLAGS) $(CFLAGS)"

-include cuda/*.d

clean:
	rm -f *.o cuda/*.o cuda/*.d $(SHLIB)

.PHONY: all clean ensure-makevars
